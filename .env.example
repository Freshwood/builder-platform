# --- API ---
DATABASE_URL=postgresql+psycopg://homeworking:homeworking@localhost:5433/homeworking
SESSION_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development

# --- LLM (ADR-0003) ---
# test   = deterministic offline model (no API key, used in CI/E2E)
# openai = any OpenAI-compatible endpoint (OpenRouter, LiteLLM proxy, Mistral, Azure, Ollama, vLLM)
LLM_MODE=test
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=
LLM_API_KEY=
# OpenRouter only: reasoning effort (off|minimal|low|medium|high); thinking stays out of the answer
LLM_REASONING=low

# --- Web ---
API_ORIGIN=http://localhost:8000

# --- Tooling (optional) ---
# WSL with the repo under /mnt/c: keep the virtualenv on the Linux filesystem for much faster
# imports. Task loads this file, so `task dev` / `task test` pick it up.
# UV_PROJECT_ENVIRONMENT=/home/<user>/.venvs/homeworking
