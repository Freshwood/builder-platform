{
  "object_type": "Podest",
  "summary": "Podest für eine Modenschau, Oberfläche wählbar",
  "params": [
    {"name": "length_mm", "label": "Länge", "kind": "length", "default": 2000, "min": 800, "max": 2500},
    {"name": "deck_boards", "label": "Anzahl Deckbretter (je 125 mm breit)", "kind": "count", "default": 8, "min": 5, "max": 10},
    {"name": "height_mm", "label": "Höhe", "kind": "length", "default": 350, "min": 200, "max": 600},
    {
      "name": "surface",
      "label": "Oberfläche",
      "kind": "choice",
      "default": "boards",
      "options": [
        {"value": "boards", "label": "Einzelne Bretter"},
        {"value": "panel", "label": "Platte"}
      ]
    },
    {"name": "toe_board", "label": "Verschalung vorne", "kind": "bool", "default": true}
  ],
  "parts": [
    {
      "id": "leg",
      "name": "Bein",
      "material": "frame_spruce_44x44",
      "size": [44, 44, "height_mm - 18"],
      "at": ["i % 2 * (length_mm - 44)", "i // 2 * (deck_boards * 125 - 44)", 0],
      "repeat": {"count": 4}
    },
    {
      "id": "frame_long",
      "name": "Längszarge",
      "material": "frame_spruce_44x44",
      "size": ["length_mm - 88", 44, 44],
      "at": [44, "i * (deck_boards * 125 - 44)", "height_mm - 62"],
      "repeat": {"count": 2}
    },
    {
      "id": "top_boards",
      "name": "Deckbrett",
      "material": "lumber_spruce_18x125",
      "size": ["length_mm", 125, 18],
      "at": [0, "i * 125", "height_mm - 18"],
      "repeat": {"count": "deck_boards"},
      "when": "surface == 'boards'"
    },
    {
      "id": "top_panel",
      "name": "Platte",
      "material": "plywood_birch_18",
      "size": ["length_mm", "deck_boards * 125", 18],
      "at": [0, 0, "height_mm - 18"],
      "when": "surface == 'panel'"
    },
    {
      "id": "toe_board",
      "name": "Verschalung",
      "material": "board_spruce_18x146",
      "size": ["length_mm - 88", 146, 18],
      "at": [44, 0, "height_mm - 164"],
      "when": "toe_board"
    }
  ]
}
